# 接続情報。`cp .env.example .env` して使う（.env は .gitignore 対象）。
# 実際の環境変数のほうが優先されるので、CI や本番では export で渡してよい。

# --- 移行元: 旧環境 learningware-kiracari のローカル DB ---
# learningware-kiracari の docker-compose.yml（db サービス / container: kiracari_db）
#   ポート 3306 / DB lw2 / user lw2user / password lw2pass
SOURCE_DB_URL=mysql://lw2user:lw2pass@127.0.0.1:3306/lw2

# --- 移行先: 新環境 school-launcher のローカル DB ---
# school-launcher の docker-compose.yml（mysql サービス / image mysql:8.4）
#   ホスト側ポートは 3307（コンテナ内 3306）/ DB learningware / user learningware
TARGET_DB_URL=mysql://learningware:learningware@127.0.0.1:3307/learningware

LOG_LEVEL=INFO

# --- 旧環境の秘密鍵（パスワードの復号に使う） ---
# learningware-kiracari の application/configs/application.ini の
#   security.mcrypt.key
# **設定ファイルには書かない。** これが無いと会員の移行は止まる。
LW2_CRYPT_KEY=
